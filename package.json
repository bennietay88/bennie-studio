{
  "name": "bennie-tay-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Professionally managed website service for customer enquiry generation.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx api/index.ts",
    "build": "vite build && esbuild api/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "vercel-build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "smoke:public": "node scripts/smoke.mjs",
    "smoke:staging": "node scripts/smoke.mjs",
    "smoke:auth": "node scripts/auth-smoke.mjs",
    "smoke:audit": "node --import tsx scripts/audit-smoke.ts",
    "test:seo": "node --import tsx --test tests/seo-audit.test.ts",
    "test:sales": "node --import tsx --test tests/commercial-pricing.test.ts tests/sales-call-slots.test.ts tests/sales-automation.test.ts tests/sales-operations.test.ts tests/onboarding.test.ts tests/launch-foundation.test.ts",
    "test:sales:api": "node --import tsx --test tests/sales-api-boundaries.test.ts",
    "test:billing": "node --import tsx --test tests/billing-hardening.test.ts",
    "test:design": "node --import tsx --test tests/design-system.test.ts",
    "smoke:live": "SMOKE_BASE_URL=https://app.bennietay.com node scripts/smoke.mjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-progress": "^1.1.8",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "@stripe/stripe-js": "^9.3.1",
    "@supabase/supabase-js": "^2.101.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@upstash/redis": "^1.38.0",
    "@vercel/functions": "^3.7.6",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.15.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.22.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "openai": "^6.37.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.72.1",
    "react-joyride": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.2",
    "sonner": "^2.0.7",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
