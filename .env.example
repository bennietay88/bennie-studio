STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional sandbox-only signing secret for an isolated test deployment.
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_10_CREDITS=
VITE_STRIPE_PRICE_50_CREDITS=
VITE_STRIPE_PRICE_200_CREDITS=
BILLING_GRACE_DAYS=7
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub Actions only: used by .github/workflows/supabase-migrations.yml.
# Store these as GitHub repository/environment secrets, not Vercel public env vars.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Custom domain routing and Vercel Project Domains API.
VITE_MAIN_WEBSITE_URL=https://bennietay.com
VITE_APP_PUBLIC_URL=https://app.bennietay.com
VITE_PORTFOLIO_URL=https://portfolio.bennietay.com
PLATFORM_HOSTS=app.bennietay.com,bennietay-studio.vercel.app
VITE_PLATFORM_HOSTS=app.bennietay.com,bennietay-studio.vercel.app
WAAS_ROOT_DOMAIN=growthos.app
VITE_WAAS_ROOT_DOMAIN=growthos.app
VERCEL_CNAME_TARGET=cname.vercel-dns.com
VITE_VERCEL_CNAME_TARGET=cname.vercel-dns.com
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Async background jobs. JOB_WORKER_SECRET protects /api/jobs/process.
# QSTASH_TOKEN is optional; without it, jobs stay queued for cron/manual polling.
JOB_WORKER_SECRET=
APP_PUBLIC_URL=https://app.bennietay.com
QSTASH_TOKEN=

# Observability and error monitoring. Leave blank locally unless testing Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_VERCEL_ENV=
VITE_VERCEL_GIT_COMMIT_SHA=
VITE_PINTEREST_TAG_ID=2613283617571
HOST=127.0.0.1
PORT=3000

# AI Config
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bennie Studio <hello@your-verified-domain.com>
RESEND_WEBHOOK_SECRET=
SALES_REPLY_TO=

# Google Places API (New) for native Google Reviews website sections.
# Keep this server-side only; never expose it with a VITE_ prefix.
GOOGLE_PLACES_API_KEY=

# Vercel injects this as the Bearer token for scheduled functions.
CRON_SECRET=

# Dangerous maintenance-only switch. Leave disabled unless an approved
# platform purge window is active.
VITE_ENABLE_PLATFORM_PURGE=false
