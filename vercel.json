{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": [
    "sin1"
  ],
  "installCommand": "unset npm_config_cache_dir && npm install",
  "buildCommand": "unset npm_config_cache_dir && npm run production-build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "regions": [
        "sin1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/sales-automation",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/internal/billing/process-cancellations",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/cron/website-audits",
      "schedule": "20 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://js.stripe.com https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://s.pinimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://api.deepseek.com https://generativelanguage.googleapis.com https://api.openai.com https://api.resend.com https://ct.pinterest.com https://*.sentry.io https://*.ingest.sentry.io; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://ct.pinterest.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://checkout.stripe.com"
        }
      ]
    },
    {
      "source": "/review/:code",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/(review|admin|dashboard|checkout|preview-order|login|signup|forgot-password|reset-password|profile|manage-call|proposal|w)(?:/.*)?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/preview/template(?:/.*)?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/affiliate/(login|signup)(?:/.*)?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/api(?:/(.*))?$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/(services|about|resources|contact|templates|how-it-works|case-studies|website-audit|dental-clinics|clinic-website-design|renovation-contractor-website-design|beauty-salon-website-design|tuition-centre-website-design|consultant-website-design|professional-services-website-design|accounting-firm-website-design|local-service-website-design|book-demo|privacy|terms|cookie-policy|data-processing-agreement|subprocessors|acceptable-use-policy)/?$",
      "dest": "/$1/index.html"
    },
    {
      "src": "^/case-studies/showcase/(dental-clinic|renovation-contractor|professional-advisory|tuition-centre|beauty-wellness|accounting-firm)/?$",
      "dest": "/case-studies/showcase/$1/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "release-candidate/**": true
    }
  }
}
